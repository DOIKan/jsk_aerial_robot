  Global Options:
    Fixed Frame: uuv_d/fc
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.5
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Name: Current View
      Pitch: 0.35
      Target Frame: <Fixed Frame>
      Yaw: 0.8
    Saved: ~
