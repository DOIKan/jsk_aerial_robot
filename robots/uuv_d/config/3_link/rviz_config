Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
    - Class: rviz/TF
      Enabled: true
      Frames:
        All Enabled: true
      Name: TF
      Show Axes: true
      Show Names: true
    - Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: uuv_d/robot_description
      TF Prefix: uuv_d
    - Class: rviz/WrenchStamped
      Enabled: true
      Force Arrow Scale: 0.2
      Force Color: 35; 166; 190
      Name: Buoyancy link1
      Topic: /uuv_d/debug/buoyancy_wrench/link1
