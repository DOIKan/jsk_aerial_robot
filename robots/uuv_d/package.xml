<?xml version="1.0"?>
<package>
  <name>uuv_d</name>
  <version>1.3.6</version>
  <description>The basic packages for uuv_d</description>

  <maintainer email="doi@jsk.imi.i.u-tokyo.ac.jp">Kanichi Doi</maintainer>
  <license>BSD</license>
  <url type="website">https://github.com/JSKAerialRobot/aerial_robot</url>
  <author email="doi@jsk.imi.i.u-tokyo.ac.jp">Bakui Chou</author>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>aerial_robot_control</build_depend>
  <build_depend>aerial_robot_model</build_depend>
  <build_depend>aerial_robot_simulation</build_depend>
  <build_depend>aerial_robot_msgs</build_depend>
  <build_depend>eigen_conversions</build_depend>
  <build_depend>gazebo_ros_control</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>mujoco_ros_control</build_depend>
  <build_depend>mujoco_ros_utils</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>spinal</build_depend>
  <build_depend>std_srvs</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>tf_conversions</build_depend>

  <run_depend>aerial_robot_base</run_depend>
  <run_depend>aerial_robot_control</run_depend>
  <run_depend>aerial_robot_model</run_depend>
  <run_depend>aerial_robot_msgs</run_depend>
  <run_depend>aerial_robot_simulation</run_depend>
  <run_depend>eigen_conversions</run_depend>
  <run_depend>gazebo_ros_control</run_depend>
  <run_depend>geometry_msgs</run_depend>
  <run_depend>mujoco_ros_utils</run_depend>
  <run_depend>pluginlib</run_depend>
  <run_depend>roscpp</run_depend>
  <run_depend>sensor_msgs</run_depend>
  <run_depend>python3-can</run_depend>
  <run_depend>rosserial_python</run_depend>
  <run_depend>std_msgs</run_depend>
  <run_depend>spinal</run_depend>
  <run_depend>std_srvs</run_depend>
  <run_depend>tf</run_depend>
  <run_depend>tf_conversions</run_depend>

  <test_depend>rostest</test_depend>

  <export>
    <aerial_robot_control plugin="${prefix}/plugins/flight_control_plugins.xml" />
    <aerial_robot_model plugin="${prefix}/plugins/robot_model_plugins.xml"/>
    <gazebo_ros_control plugin="${prefix}/plugins/buoyancy_hw_sim_plugins.xml"/>
  </export>

</package>
