<launch>
  <arg name="robot_ns" default="uuv_d" />
  <arg name="robstride_config" />
  <arg name="xiaomimotor_source" default="/home/doi/code/robstride/xiaomimotor_lib/src" />
  <arg name="auto_enable" default="false" />

  <group ns="$(arg robot_ns)">
    <node pkg="uuv_d" type="robstride_joint_bridge.py" name="robstride_joint_bridge" output="screen">
      <rosparam file="$(arg robstride_config)" command="load" />
      <env name="PYTHONPATH" value="$(arg xiaomimotor_source):$(optenv PYTHONPATH)" />
    </node>
    <node pkg="uuv_d" type="robstride_startup.py" name="robstride_startup" output="screen" if="$(arg auto_enable)" />
  </group>
</launch>
