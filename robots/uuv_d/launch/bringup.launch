<?xml version="1.0"?>
<launch>
  ###########  launch config  ###########
  <arg name="real_machine" default="True" />
  <arg name="simulation" default="False" />
  <arg name="type" default="quad" />
  <arg name="onboards_model" default="prototype_202605" />
  <arg name="external_wrench_feedforward" default="false" />
  <arg name="estimate_mode"  default= "1" />
  <arg name="sim_estimate_mode"  default= "2" />
  <arg name="headless" default="True" />
  <arg name="worldtype" default="$(find aerial_robot_simulation)/gazebo_model/world/empty_underwater.world" />
  <arg name="launch_gazebo" default="True" />
  <arg name="direct_model" default="False" />
  <arg name="direct_model_name" />
  <arg name="spawn_x" default="0.0"/>
  <arg name="spawn_y" default="0.0"/>
  <arg name="spawn_z" default="-2.0"/>
  <arg name="spawn_roll" default="0.0"/>
  <arg name="spawn_pitch" default="0.0"/>
  <arg name="spawn_yaw" default="0.0"/>
  <arg name="robot_id" default="" />
  <arg name="robot_ns" value="uuv_d$(arg robot_id)" />
  <arg name="config_dir" default="$(find uuv_d)/config" />
  <arg name="mujoco" default="False" />
  <arg name="demo" default="True" />
  <!-- Set true only when the external joint and gimbal drivers are configured. -->
  <arg name="external_actuators" default="False" />
  <arg name="robstride_config" default="" />
  <arg name="gimbal_pwm_config" default="" />
  <arg name="arduino_port" default="" />
  <arg name="arduino_baud" default="115200" />
  <arg name="xiaomimotor_source" default="/home/doi/code/robstride/xiaomimotor_lib/src" />
  <arg name="robstride_auto_enable" default="false" />

  ###########  Parameters  ###########
  <group ns="$(arg robot_ns)">

    ###########  Basic Param  ###########
    # EGOMOTION_ESTIMATE = 0
    # EXPERIMENT_ESTIMATE = 1. for unstable mocap, use this mode
    # GROUND_TRUTH = 2
    <param name="estimation/mode" value= "$(arg sim_estimate_mode)" if="$(arg simulation)" />
    <param name="estimation/mode" value= "$(arg estimate_mode)" if="$(eval arg('real_machine') and not arg('simulation'))"/>

    # HYDRUS = 16 # 0x10, hydrus type with  4dof underactuated property
    <param name="uav_model" value= "16" />
    <rosparam file="$(arg config_dir)/$(arg onboards_model)/RobotModel.yaml" command="load" />

    ###########  Motor Config  ###########
    <rosparam file="$(arg config_dir)/$(arg onboards_model)/MotorInfo.yaml" command="load" />

    ###########  Servo Config  ###########
    <rosparam file="$(arg config_dir)/$(arg onboards_model)/Servo.yaml" command="load" />

    ###########  Battery Config  ###########
    <rosparam file="$(arg config_dir)/$(arg onboards_model)/Battery.yaml" command="load" />

    ###########  Environment Config  ###########
    <rosparam file="$(arg config_dir)/Environment.yaml" command="load" />
    <rosparam file="$(arg config_dir)/prototype_202605/Environment.yaml" command="load" if="$(eval arg('onboards_model') == 'prototype_202605' and arg('external_wrench_feedforward'))" />
    <rosparam file="$(arg config_dir)/prototype_202605/SimulationEnvironment.yaml" command="load" if="$(eval arg('onboards_model') == 'prototype_202605' and arg('external_wrench_feedforward') and arg('simulation') and not arg('real_machine'))" />
    <rosparam file="$(arg config_dir)/3_link/Environment.yaml" command="load" if="$(eval arg('onboards_model') == '3_link')" />

    ###########  Control  ###########
    <rosparam file="$(arg config_dir)/$(arg onboards_model)/FlightControl.yaml" command="load" />
    <param name="controller/external_wrench_feedforward_enabled" value="$(arg external_wrench_feedforward)" if="$(eval arg('onboards_model') == 'prototype_202605')" />

    ###########  Sensor Fusion  ###########
    <rosparam file="$(arg config_dir)/$(arg onboards_model)/StateEstimation.yaml" command="load" />
    <rosparam file="$(arg config_dir)/Simulation.yaml" command="load" if="$(eval arg('simulation') and not arg('real_machine'))"/>

    ###########  Navigation  ###########
    <rosparam file="$(arg config_dir)/NavigationConfig.yaml" command="load" />
  </group>

  ###########  Base Platform  ###########
  <node pkg="aerial_robot_base" type="aerial_robot_base_node" name="aerial_robot_base_node" ns="$(arg robot_ns)" output="screen">
    <param name="tf_prefix" value="$(arg robot_ns)"/>
    <param name="param_verbose" value="false"/>
    <param name="main_rate" value="40"/>
  </node>

  ###########  Robot Model  ###########
  <arg name="description_mode" value="urdf" unless="$(arg simulation)" />
  <arg name="description_mode" value="gazebo" if="$(arg simulation)" />
  <include file="$(find aerial_robot_model)/launch/aerial_robot_model.launch" >
    <arg name="headless" value="$(arg headless)" />
    <arg name="model_options" value="external_wrench_feedforward:=$(arg external_wrench_feedforward)" if="$(eval arg('onboards_model') == 'prototype_202605' and arg('simulation'))" />
    <arg name="robot_model" value="$(find uuv_d)/robots/$(arg onboards_model)/robot.$(arg description_mode).xacro" unless="$(arg direct_model)"/>
    <arg name="robot_model" value="$(arg direct_model_name)" if="$(arg direct_model)"/>
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="rviz_config" value="$(find uuv_d)/config/3_link/rviz_config" if="$(eval arg('onboards_model') == '3_link')" />
    <arg name="rviz_config" value="$(find uuv_d)/config/rviz_config" unless="$(eval arg('onboards_model') == '3_link')" />
    <arg name="rviz_init_pose" value="$(arg config_dir)/RvizInit.yaml" />
    <arg name="need_joint_state" value="false" if ="$(eval arg('simulation') or arg('real_machine'))"/>
  </include>

  ###########  Sensors ###########
  <include file="$(find uuv_d)/launch/includes/sensors.launch.xml" >
    <arg name="real_machine" value="$(arg real_machine)" />
    <arg name="simulation" value="$(arg simulation)" />
    <arg name="robot_ns" value="$(arg robot_ns)" />
  </include >

  ###########  Servo Bridge  ###########
  <node pkg="aerial_robot_model" type="servo_bridge_node" name="servo_bridge" ns="$(arg robot_ns)" output="screen" unless="$(eval arg('real_machine') and not arg('simulation') and arg('external_actuators') and arg('onboards_model') == '3_link')" >
    <param name="use_mujoco" value="true" if="$(arg mujoco)"/>
  </node>

  <include file="$(find uuv_d)/launch/includes/external_actuators.launch.xml" if="$(eval arg('real_machine') and not arg('simulation') and arg('external_actuators') and arg('onboards_model') == '3_link')">
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="robstride_config" value="$(arg robstride_config)" />
    <arg name="gimbal_pwm_config" value="$(arg gimbal_pwm_config)" />
    <arg name="arduino_port" value="$(arg arduino_port)" />
    <arg name="arduino_baud" value="$(arg arduino_baud)" />
    <arg name="xiaomimotor_source" value="$(arg xiaomimotor_source)" />
    <arg name="robstride_auto_enable" value="$(arg robstride_auto_enable)" />
  </include>

  ########## Simulation in Gazebo #########
  <include file="$(find aerial_robot_simulation)/launch/gazebo.launch" if = "$(eval arg('simulation') and not arg('real_machine') and not arg('mujoco'))" >
    <arg name="robot_ns" default="$(arg robot_ns)" />
    <arg name="gui" default="false" if="$(arg headless)" />
    <arg name="headless" default="$(arg headless)" />
    <arg name="launch_gazebo" default="$(arg launch_gazebo)" />
    <arg name="worldtype" value="$(arg worldtype)" />
    <arg name="spawn_x" value="$(arg spawn_x)" />
    <arg name="spawn_y" value="$(arg spawn_y)" />
    <arg name="spawn_z" value="$(arg spawn_z)" />
    <arg name="spawn_roll" value="$(arg spawn_roll)" />
    <arg name="spawn_pitch" value="$(arg spawn_pitch)" />
    <arg name="spawn_yaw" value="$(arg spawn_yaw)" />
  </include>

  ########## Simulation in Mujoco #########
  <include file="$(find aerial_robot_simulation)/launch/mujoco.launch" if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco'))" >
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="headless" value="$(arg headless)"/>
    <arg name="mujoco_model" value="$(find uuv_d)/mujoco/$(arg onboards_model)/robot.xml"/>
  </include>

  ########## Simple Demo #########
  <!-- <node pkg="uuv_d" type="loop_demo.py" name="loop_demo" ns="$(arg robot_ns)" output="screen" if="$(arg demo)"/> -->

</launch>
